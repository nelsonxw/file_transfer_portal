# Firebase Configuration
# Either set the path to the service account JSON file (local / file-based hosts)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# Or paste the full JSON contents (Vercel / serverless)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=file-transfer-2618f.firebasestorage.app

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
PRESIGNED_URL_EXPIRATION=900
